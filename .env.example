# Copy this file to .env to change any of these settings. All of them are optional locally.
PORT=3000
DATABASE_PATH=data/trackbuzz.db

# Set to production on a live server. This also makes login cookies HTTPS-only.
NODE_ENV=development

# Set to 1 only when the app runs behind a proxy you control, such as a hosting platform's load balancer.
TRUST_PROXY=0

# A way for MusicBrainz to reach you about your traffic: your site, repo, or email address.
MUSICBRAINZ_CONTACT=https://github.com/DPaolella14/TrackBuzz

# Set to off to stop automatic imports, for example while trying the demo data.
CATALOG_SYNC=on
CATALOG_SYNC_HOURS=24
CATALOG_MAX_NEW_PER_SYNC=1000
