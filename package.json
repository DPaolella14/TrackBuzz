{
  "name": "trackbuzz",
  "version": "0.1.0",
  "description": "Browse music and talk about it: personal stories, concert memories, performance tips, and 0-10 ratings.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "catalog:sync": "node --disable-warning=ExperimentalWarning scripts/catalog.js sync",
    "catalog:import": "node --disable-warning=ExperimentalWarning scripts/catalog.js import",
    "catalog:full-import": "node --disable-warning=ExperimentalWarning --max-old-space-size=6144 scripts/full-import.js"
  }
}
